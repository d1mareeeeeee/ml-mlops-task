{
  "permissions": {
    "deny": [
      "Edit(fixtures/**)",
      "Edit(package-lock.json)",
      "Edit(uv.lock)",
      "Edit(CONTRACT.md)",
      "Edit(Dockerfile)",
      "Edit(.env)",
      "Read(.env)"
    ],
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm test)",
